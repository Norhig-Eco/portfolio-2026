---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/UI/Button.astro';
import Card from '../components/UI/Card.astro';
---

<BaseLayout title="NikoEco | HCI Researcher & AI Designer" description="Portfolio of Niko Economou. HCI Researcher and AI-Learning Experience Designer.">
  {/* Hero Section */}
  <section class="py-20 flex flex-col-reverse md:flex-row items-center gap-16 border-b border-sage mb-16">
    <div class="flex-1 text-center md:text-left">
      <div class="inline-block px-4 py-1.5 mb-8 text-xs font-mono font-medium tracking-wide text-sage-dark bg-sage-light border border-sage rounded-full">
        M.I.D. Human-Computer Interaction @ Georgia Tech
      </div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-light text-slate-900 tracking-tight mb-4 leading-tight">
        Niko Economou
      </h1>
      <h2 class="text-2xl md:text-3xl text-slate-900 font-bold mb-8">
        HCI Researcher & AI-Learning Experience Designer
      </h2>
      <p class="text-lg text-slate-600 max-w-xl mb-10 leading-relaxed font-light mx-auto md:mx-0">
        I blend cognitive science, psychology, and computer science to design supportive, scaffolded learning systems.
      </p>
      <div class="flex justify-center md:justify-start gap-4">
        <Button href="/projects" class="bg-sage-dark hover:bg-[#5a674d] text-white rounded-lg border-none px-8 py-3 shadow-md">Projects</Button>
        <Button href="/about" variant="outline" class="rounded-lg border-sage text-slate-700 hover:bg-sage-light px-8 py-3 bg-white/50">About Me</Button>
      </div>
      <div class="mt-10 flex justify-center md:justify-start gap-6">
        <a href="https://www.linkedin.com/in/nikoeco/" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-sage-dark font-medium text-sm transition-colors flex items-center gap-2">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
          </svg>
          LinkedIn
        </a>
        <a href="https://github.com/Norhig-Eco" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-sage-dark font-medium text-sm transition-colors flex items-center gap-2">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="flex-shrink-0 relative mx-auto md:mx-0 w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96">
      <div class="absolute inset-0 bg-sage-light rounded-[2rem] rotate-6 scale-105 border border-sage"></div>
      <img src="/images/headshot.jpeg" alt="Niko Economou" class="absolute inset-0 w-full h-full object-cover rounded-[2rem] shadow-2xl border-4 border-white" />
    </div>
  </section>

  {/* Dynamic Gallery & Featured Projects */}
  <section class="mb-20">
    <div class="flex justify-between items-end mb-10 border-b border-sage pb-4">
      <h2 class="text-3xl font-light text-slate-900">Featured Work</h2>
      <a href="/projects" class="text-sage-dark hover:text-[#5a674d] font-mono text-sm font-medium transition-colors">View all cases &rarr;</a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <Card 
        title="Mental Sketching Models"
        description="My Master's Thesis: an AI-augmented digital canvas that explores distributed cognition and real-time generative sketch support."
        href="/projects/masters-thesis"
        image="/images/thesis/deliverables/Slide 16_9 - 1.png"
        tags={['UX Research', 'AI Product Design', 'Cognitive Psychology']}
      />
      
      <Card 
        title="Smart Fitness Mirror"
        description="Award-winning interactive smart mirror designed to support and encourage healthy habit tracking through intuitive visual feedback."
        href="/projects/smart-fitness-mirror"
        image="/images/older-studio/Smart Mirror Project/Fairest 5.png"
        tags={['European Product Design Award', 'FIT Award 2023', 'Interaction Design']}
      />
    </div>
  </section>
</BaseLayout>
