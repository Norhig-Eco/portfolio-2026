---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  tags?: string[];
}

const { title, description, href, image, tags = [] } = Astro.props;
---

<a href={href} class="group flex flex-col bg-white border border-sage rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
  {image && (
    <div class="h-56 w-full overflow-hidden bg-sage-light border-b border-sage">
      <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    </div>
  )}
  <div class="p-8 flex flex-col flex-grow">
    <h3 class="text-xl font-semibold text-slate-900 mb-3 group-hover:text-sage-dark transition-colors">{title}</h3>
    <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">{description}</p>
    
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-auto pt-6 border-t border-slate-100">
        {tags.map((tag) => (
          <span class="inline-flex items-center px-2.5 py-1 text-xs font-mono bg-sage-light text-sage-dark rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
